// res/plugin.rc — Windows DLL version resource.

#include <winver.h>

#define PLUGIN_VER_MAJOR 0
#define PLUGIN_VER_MINOR 1
#define PLUGIN_VER_PATCH 0
#define PLUGIN_VER_BUILD 0
#define PLUGIN_VER_STR   "0.1.0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    PLUGIN_VER_MAJOR,PLUGIN_VER_MINOR,PLUGIN_VER_PATCH,PLUGIN_VER_BUILD
 PRODUCTVERSION PLUGIN_VER_MAJOR,PLUGIN_VER_MINOR,PLUGIN_VER_PATCH,PLUGIN_VER_BUILD
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "synqark"
            VALUE "FileDescription",  "Metasequoia Physics Plugin"
            VALUE "FileVersion",      PLUGIN_VER_STR
            VALUE "InternalName",     "MetaseqPhysics"
            VALUE "LegalCopyright",   "Copyright (c) 2026 synqark"
            VALUE "OriginalFilename", "MetaseqPhysics.dll"
            VALUE "ProductName",      "Metaseq Physics"
            VALUE "ProductVersion",   PLUGIN_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
